# Copie para .env (o script scripts/07-generate-env.sh faz isso automaticamente)
# e preencha os valores. Este arquivo .example é seguro para commitar; o .env
# real NUNCA deve ser commitado (já está no .gitignore).

PUID=1000
PGID=1000
TZ=America/Recife

# Caminhos nos HDDs separados (ver scripts/02-setup-disks.sh)
MEDIA_ROOT=/mnt/hdd1/media
DOWNLOADS_ROOT=/mnt/hdd2/downloads
