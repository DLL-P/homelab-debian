TZ=America/Recife

# Dispositivo real do(s) disco(s) monitorado(s) pelo Scrutiny.
# Descubra com: lsblk (ex: /dev/sda para o SSD, /dev/sdb e /dev/sdc para os HDDs)
SCRUTINY_DISK_1=/dev/sda
SCRUTINY_DISK_2=/dev/sdb
SCRUTINY_DISK_3=/dev/sdc

# URL de notificação do Diun (ex: ntfy://ntfy.sh/seu-topico ,
# discord://webhook_id/webhook_token , telegram://token@telegram?chats=chat_id)
DIUN_NOTIF_URL=
